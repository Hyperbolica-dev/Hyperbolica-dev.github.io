---
import avatar from '../assets/tanh_avatar.png';
import darkAvatar from '../assets/tanh_avatar-dark.png';
---

<div class="blog-profile-block">
	<a class="blog-profile-link" href="/about/" aria-label="About Hyperbolica-dev">
		<img
			class="blog-profile-avatar blog-profile-avatar-light"
			src={avatar.src}
			alt=""
			width="48"
			height="48"
			loading="lazy"
		/>
		<img
			class="blog-profile-avatar blog-profile-avatar-dark"
			src={darkAvatar.src}
			alt=""
			width="48"
			height="48"
			loading="lazy"
		/>
		<strong>Hyperbolica-dev</strong>
	</a>
	<a class="blog-github-profile" href="https://github.com/Hyperbolica-dev" rel="me">GitHub profile</a>
</div>

<style>
	.blog-profile-block {
		display: grid;
		gap: 0.15rem;
		margin-top: auto;
		border-top: 1px solid var(--sl-color-hairline-shade);
		padding: 0.9rem 0.5rem 0.25rem;
	}

	.blog-profile-link {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--sl-color-text);
		text-decoration: none;
	}

	.blog-profile-link:hover,
	.blog-profile-link:focus-visible {
		color: var(--sl-color-white);
	}

	.blog-profile-link:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.blog-profile-avatar {
		width: 2.25rem;
		height: 2.25rem;
		flex: 0 0 2.25rem;
		border-radius: 50%;
		display: block;
		object-fit: contain;
	}

	.blog-profile-avatar-dark {
		display: none;
	}

	:global(html[data-theme='dark']) .blog-profile-avatar-light {
		display: none;
	}

	:global(html[data-theme='dark']) .blog-profile-avatar-dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(html[data-theme='auto']) .blog-profile-avatar-light {
			display: none;
		}

		:global(html[data-theme='auto']) .blog-profile-avatar-dark {
			display: block;
		}
	}

	.blog-profile-link strong {
		min-width: 0;
		overflow-wrap: anywhere;
		font-size: var(--sl-text-sm);
	}

	.blog-github-profile {
		padding-inline-start: 3rem;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-xs);
		text-decoration: none;
	}

	.blog-github-profile:hover,
	.blog-github-profile:focus-visible {
		text-decoration: underline;
	}

	@media (max-width: 49.99rem) {
		.blog-profile-block {
			display: none;
		}
	}
</style>
