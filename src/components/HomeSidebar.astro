---
import { getTagCollection } from '../lib/content';

const tags = (await getTagCollection())
	.sort((left, right) => right.count - left.count || left.tag.localeCompare(right.tag))
	.slice(0, 8);
---

<aside class="blog-home-sidebar" aria-label="Home page topics">
	<h2>Topics</h2>
	<div class="blog-home-tags">
		{tags.length > 0 ? (
			tags.map(({ tag, count }) => (
				<a href={`/tags/${encodeURIComponent(tag)}/`}>
					{tag}<sup>{count}</sup>
				</a>
			))
		) : (
			<span class="blog-home-empty">Tags appear with published articles.</span>
		)}
	</div>
	<a class="blog-home-all" href="/tags/">All articles <span aria-hidden="true">→</span></a>
</aside>

<style>
	.blog-home-sidebar {
		display: grid;
		gap: 0.8rem;
		margin-block: 1.5rem;
	}

	.blog-home-sidebar h2 {
		margin: 0;
		font-size: var(--sl-text-lg);
	}

	.blog-home-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.blog-home-tags a {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		padding: 0.2rem 0.55rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-xs);
		text-decoration: none;
	}

	.blog-home-tags a:hover,
	.blog-home-tags a:focus-visible,
	.blog-home-all:hover,
	.blog-home-all:focus-visible {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}

	.blog-home-tags sup {
		margin-inline-start: 0.25rem;
		color: var(--sl-color-gray-3);
		font-size: 0.7em;
	}

	.blog-home-empty {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.blog-home-all {
		justify-self: start;
		border-bottom: 1px solid transparent;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
</style>
