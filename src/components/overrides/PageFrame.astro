---
import BlogSidebar from '../BlogSidebar.astro';
import SidebarResizeControl from '../SidebarResizeControl.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="blog-page">
	<div class="blog-shell">
		<slot name="header" />
		{hasSidebar && (
			<div class="blog-shell-body">
				<aside
					id="blog-sidebar-column"
					class="blog-sidebar-column print:hidden"
					aria-label="Site navigation"
				>
					<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
						<BlogSidebar />
					</sl-sidebar-pane>
				</aside>
				<div class="blog-main-frame">
					<slot />
				</div>
				<SidebarResizeControl />
			</div>
		)}
	</div>
</div>

<script is:inline>
	(() => {
		if (customElements.get('sl-sidebar-pane')) return;
		class StarlightSidebarPane extends HTMLElement {
			constructor() {
				super();
				const desktopMediaQuery = matchMedia('(min-width: 50rem)');
				const resetPopoverAttribute = () => {
					this.popover = desktopMediaQuery.matches ? null : 'auto';
				};
				resetPopoverAttribute();
				desktopMediaQuery.addEventListener('change', resetPopoverAttribute);
				this.addEventListener('toggle', ({ newState }) => {
					document.querySelectorAll('.blog-main-frame, .sl-skip-link').forEach((element) => {
						element.toggleAttribute('inert', newState === 'open');
					});
				});
			}
		}
		customElements.define('sl-sidebar-pane', StarlightSidebarPane);
	})();
</script>

<style>
	@layer starlight.core {
		.blog-page {
			min-height: 100vh;
			padding: 1rem;
			background: var(--blog-page-background);
		}

		.blog-shell {
			position: relative;
			width: min(100%, var(--blog-shell-max-width));
			min-height: calc(100vh - 2rem);
			margin-inline: auto;
			overflow: hidden;
			border: 1px solid var(--sl-color-hairline-shade);
			border-radius: 1rem;
			background: var(--sl-color-bg);
			box-shadow: var(--blog-shell-shadow);
		}

		.blog-shell-body {
			display: grid;
			grid-template-columns: var(--blog-sidebar-width) minmax(0, 1fr);
			min-height: calc(100vh - var(--blog-header-height) - 2rem);
			transition: grid-template-columns 150ms ease;
		}

		.blog-sidebar-column {
			min-width: 0;
			background: var(--sl-color-bg-sidebar);
			border-inline-end: 1px solid var(--sl-color-hairline-shade);
		}

		.sidebar-pane {
			position: sticky;
			top: 0;
			width: 100%;
			height: calc(100vh - var(--blog-header-height) - 2rem);
			max-height: calc(100vh - var(--blog-header-height) - 2rem);
			border: 0;
			margin: 0;
			padding: 0;
			background: transparent;
			color: inherit;
			overflow-y: auto;
			overflow-x: hidden;
		}

		.blog-main-frame {
			min-width: 0;
			min-height: 100%;
			padding: 0;
		}

		@media (max-width: 49.99rem) {
			.blog-page {
				padding: 0;
			}

			.blog-shell {
				width: 100%;
				min-height: 100vh;
				border: 0;
				border-radius: 0;
				box-shadow: none;
			}

			.blog-shell-body {
				display: block;
				min-height: calc(100vh - var(--blog-header-height));
			}

			.blog-sidebar-column {
				border: 0;
			}

			.sidebar-pane {
				position: fixed;
				z-index: var(--sl-z-index-menu);
				inset: var(--blog-header-height) 0 0;
				width: min(22rem, 88vw);
				height: auto;
				max-height: none;
				background: var(--sl-color-bg-sidebar);
				box-shadow: var(--sl-shadow-lg);
			}

			.blog-main-frame {
				width: 100%;
			}
		}

		@media (min-width: 50rem) {
			.sidebar-pane {
				display: block;
			}
		}
	}
</style>
