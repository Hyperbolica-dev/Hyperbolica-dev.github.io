---
const { toc } = Astro.locals.starlightRoute;
---

<div class="lg:sl-flex blog-two-column-content">
	{
		toc && (
			<aside class="right-sidebar-container print:hidden">
				<div
					class="blog-toc-resizer"
					role="separator"
					aria-label="Resize table of contents"
					aria-orientation="vertical"
					aria-valuemin="0"
					aria-valuemax="32"
					aria-valuenow="19"
					aria-valuetext="19rem"
					tabindex="0"
					data-blog-toc-resizer
					data-min-width-rem="0"
					data-collapse-threshold-rem="12"
					data-max-width-rem="32"
					data-default-width-rem="19"
					hidden
				></div>
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.right-sidebar-container {
				order: 2;
				position: relative;
				width: max(
					var(--blog-toc-width),
					calc(
						var(--blog-toc-width) +
							(100% - var(--sl-content-width) - var(--blog-toc-width)) / 2
					)
				);
			}

			.right-sidebar {
				position: fixed;
				top: 0;
				padding-top: var(--sl-nav-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
				border-inline-start: 0;
			}

			.main-pane {
				width: 100%;
			}

			:global(html[data-blog-toc-collapsed]) .right-sidebar-container {
				width: 0;
				overflow: visible;
			}

			:global(html[data-blog-toc-collapsed]) .right-sidebar {
				display: none;
			}

			:global([data-has-sidebar][data-has-toc]) .main-pane {
				--sl-content-margin-inline: auto 0;

				order: 1;
				width: min(
					calc(100% - var(--blog-toc-width)),
					calc(
						var(--sl-content-width) +
							(100% - var(--sl-content-width) - var(--blog-toc-width)) / 2
					)
				);
			}

			:global(html[data-blog-toc-collapsed][data-has-sidebar][data-has-toc]) .main-pane {
				width: 100%;
			}
		}
	}
</style>

<script is:inline>
	(() => {
		const resizer = document.querySelector('[data-blog-toc-resizer]');
		if (!(resizer instanceof HTMLElement)) return;

		const root = document.documentElement;
		const storageKey = 'hyperbolica-toc-width';
		const desktopQuery = window.matchMedia('(min-width: 72rem)');
		const minWidthRem = Number(resizer.dataset.minWidthRem);
		const collapseThresholdRem = Number(resizer.dataset.collapseThresholdRem);
		const maxWidthRem = Number(resizer.dataset.maxWidthRem);
		const defaultWidthRem = Number(resizer.dataset.defaultWidthRem);

		const roundWidth = (widthRem) => Math.round(widthRem * 10) / 10;
		const normalizeWidth = (widthRem) => {
			const roundedWidth = roundWidth(widthRem);
			if (roundedWidth <= collapseThresholdRem) return minWidthRem;
			return Math.min(maxWidthRem, Math.max(collapseThresholdRem, roundedWidth));
		};

		const readWidth = () => {
			try {
				const stored = Number(window.localStorage.getItem(storageKey));
				return Number.isFinite(stored) ? normalizeWidth(stored) : normalizeWidth(defaultWidthRem);
			} catch {
				return normalizeWidth(defaultWidthRem);
			}
		};

		const persistWidth = (widthRem) => {
			try {
				window.localStorage.setItem(storageKey, String(widthRem));
			} catch {
				// Private browsing and blocked storage should not disable resizing.
			}
		};

		const setValueAttributes = (widthRem) => {
			resizer.setAttribute('aria-valuenow', String(widthRem));
			resizer.setAttribute('aria-valuetext', `${widthRem}rem`);
		};

		const applyWidth = (widthRem, persist = false) => {
			const nextWidth = normalizeWidth(widthRem);
			root.style.setProperty('--blog-toc-width', `${nextWidth}rem`);
			root.toggleAttribute('data-blog-toc-collapsed', nextWidth === minWidthRem);
			setValueAttributes(nextWidth);
			if (persist) persistWidth(nextWidth);
			return nextWidth;
		};

		const syncAvailability = () => {
			const available = desktopQuery.matches;
			resizer.hidden = !available;
			resizer.tabIndex = available ? 0 : -1;
			resizer.setAttribute('aria-disabled', String(!available));
		};

		let widthRem = defaultWidthRem;
		let dragStartX = 0;
		let dragStartWidthRem = widthRem;

		const finishDrag = (event) => {
			if (!resizer.hasPointerCapture(event.pointerId)) return;
			resizer.releasePointerCapture(event.pointerId);
			resizer.classList.remove('is-dragging');
			if (desktopQuery.matches) persistWidth(widthRem);
		};

		const syncViewport = () => {
			if (desktopQuery.matches) {
				widthRem = applyWidth(readWidth(), true);
			} else {
				root.style.removeProperty('--blog-toc-width');
			}
			syncAvailability();
		};

		resizer.addEventListener('pointerdown', (event) => {
			if (!desktopQuery.matches || event.button !== 0) return;
			event.preventDefault();
			dragStartX = event.clientX;
			dragStartWidthRem = widthRem;
			resizer.setPointerCapture(event.pointerId);
			resizer.classList.add('is-dragging');
		});

		resizer.addEventListener('pointermove', (event) => {
			if (!desktopQuery.matches || !resizer.hasPointerCapture(event.pointerId)) return;
			const rootFontSize = Number.parseFloat(getComputedStyle(root).fontSize) || 16;
			widthRem = applyWidth(dragStartWidthRem - (event.clientX - dragStartX) / rootFontSize);
		});

		resizer.addEventListener('pointerup', finishDrag);
		resizer.addEventListener('pointercancel', finishDrag);

		resizer.addEventListener('keydown', (event) => {
			if (!desktopQuery.matches) return;

			let nextWidth;
			if (event.key === 'ArrowLeft') {
				nextWidth = widthRem === minWidthRem ? collapseThresholdRem + 1 : widthRem + 1;
			}
			if (event.key === 'ArrowRight') nextWidth = widthRem - 1;
			if (event.key === 'Home') nextWidth = minWidthRem;
			if (event.key === 'End') nextWidth = maxWidthRem;
			if (nextWidth === undefined) return;

			event.preventDefault();
			widthRem = applyWidth(nextWidth, true);
		});

		desktopQuery.addEventListener('change', syncViewport);
		syncViewport();
	})();
</script>
