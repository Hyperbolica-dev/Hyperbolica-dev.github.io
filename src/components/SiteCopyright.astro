---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<div class="site-copyright" data-pagefind-ignore>
	<small>
		© {year} <a href={site.github}>{site.copyrightHolder}</a>
	</small>
</div>

<style>
	.site-copyright {
		margin-top: 2rem;
		border-top: 1px solid var(--sl-color-hairline-shade);
		padding-top: 1rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.site-copyright small {
		font-size: inherit;
	}
	.site-copyright a {
		color: inherit;
		text-decoration: none;
	}
	.site-copyright a:hover {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
	}
	.site-copyright a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>
