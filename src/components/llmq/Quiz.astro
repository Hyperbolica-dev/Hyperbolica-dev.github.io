---
import { CONFIG } from '../../lib/llmq/config';
import { quizStrings, type QuizLanguage } from '../../lib/llmq/strings';
import '../../styles/llmq.css';
interface Props {
	language?: QuizLanguage;
}
const { language = 'en' } = Astro.props;
const strings = quizStrings(language);
---

<div
	class="lmti-app"
	role="region"
	aria-label={strings.title}
	data-lmti-app
	data-lmti-language={language}
>
	{!CONFIG.PUBLISHED && <p class="lmti-ribbon">{strings.preview}</p>}
	<p class="lmti-muted" data-lmti-counts hidden></p>
	<div class="lmti-status" role="status" aria-live="polite" data-lmti-status></div>
	<div data-lmti-screen></div>
	<noscript>
		<p>{strings.noScript}</p>
	</noscript>
	<footer class="lmti-credits">
		<h2>{strings.creditsTitle}</h2>
		<ul>
			{strings.credits.map((credit) => (
				<li>{credit}</li>
			))}
		</ul>
	</footer>
</div>

<script>
	import { mountQuiz } from '../../lib/llmq/ui';
	const app = document.querySelector<HTMLElement>('[data-lmti-app]');
	if (app) mountQuiz(app);
</script>
