---
import { Icon } from '@astrojs/starlight/components';
import { getTagCollection } from '../lib/content';
import { localeFromPath, pathForLocale, ui } from '../lib/locale';
import { site } from '../lib/site';

const locale = localeFromPath(Astro.url.pathname);
const labels = ui[locale];
const tags = (await getTagCollection())
	.sort((left, right) => right.count - left.count || left.tag.localeCompare(right.tag))
	.slice(0, 8);
---

<div class="rail-secondary">
	<section aria-labelledby="rail-topics-title">
		<h2 id="rail-topics-title">{labels.topics}</h2>
		<div class="rail-tags">
			{tags.length > 0 ? (
				tags.map(({ tag, count }) => (
					<a href={pathForLocale(`/tags/${encodeURIComponent(tag)}/`, locale)}>
						{tag}
						<sup>{count}</sup>
					</a>
				))
			) : (
				<p class="rail-tags-empty">{labels.noTags}</p>
			)}
		</div>
		<a class="rail-all" href={pathForLocale('/tags/', locale)}>
			{labels.allArticles}
			<Icon name="right-arrow" />
		</a>
	</section>
	<small class="rail-copyright">
		© {new Date().getFullYear()} {site.author}
	</small>
</div>

<style>
	.rail-secondary {
		display: grid;
		gap: 1.5rem;
	}
	.rail-secondary section {
		display: grid;
		gap: 0.75rem;
	}
	.rail-secondary h2 {
		margin: 0;
		font-size: var(--sl-text-h5);
	}
	.rail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.rail-tags a {
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 999px;
		padding: 0.25rem 0.55rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-xs);
		text-decoration: none;
	}
	.rail-tags a:hover,
	.rail-tags a:focus-visible {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}
	.rail-tags sup {
		margin-inline-start: 0.25rem;
		color: var(--sl-color-gray-3);
	}
	.rail-tags-empty {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}
	.rail-all {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		width: fit-content;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.rail-all:hover,
	.rail-all:focus-visible {
		text-decoration: underline;
	}
	.rail-copyright {
		display: block;
		border-top: 1px solid var(--sl-color-hairline-shade);
		padding-top: 1rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}
	.rail-secondary a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>
