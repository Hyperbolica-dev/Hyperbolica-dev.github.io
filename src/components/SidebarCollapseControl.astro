---
import { Icon } from '@astrojs/starlight/components';
import { localeFromPath, ui } from '../lib/locale';
const labels = ui[localeFromPath(Astro.url.pathname)];
---

<button
	type="button"
	id="blog-sidebar-collapse-control"
	class="blog-sidebar-collapse-control"
	aria-controls="blog-sidebar-column"
	aria-expanded="true"
	aria-label={labels.collapseNavigation}
	title={labels.collapseNavigation}
>
	<Icon name="bars" />
	<span class="blog-sidebar-collapse-label">{labels.collapseNavigation}</span>
</button>

<script
	is:inline
	define:vars={{ collapseLabel: labels.collapseNavigation, expandLabel: labels.expandNavigation }}
>
	(() => {
		const storageKey = 'hyperbolica-sidebar-collapsed';
		const desktopQuery = window.matchMedia('(min-width: 50rem)');
		const root = document.documentElement;

		const readPreference = () => {
			try {
				return window.localStorage.getItem(storageKey) === 'true';
			} catch {
				return false;
			}
		};

		const setCollapsed = (collapsed, persist = false) => {
			root.toggleAttribute('data-blog-sidebar-collapsed', collapsed);

			const button = document.getElementById('blog-sidebar-collapse-control');
			if (button) {
				button.setAttribute('aria-expanded', String(!collapsed));
				button.setAttribute('aria-label', collapsed ? expandLabel : collapseLabel);
				button.setAttribute('title', collapsed ? expandLabel : collapseLabel);
			}

			if (persist) {
				try {
					window.localStorage.setItem(storageKey, String(collapsed));
				} catch {
					// Private browsing and blocked storage should not disable the control.
				}
			}
		};

		const syncViewport = () => {
			if (desktopQuery.matches) {
				setCollapsed(readPreference());
			} else {
				root.removeAttribute('data-blog-sidebar-collapsed');
			}
		};

		syncViewport();
		desktopQuery.addEventListener('change', syncViewport);

		const button = document.getElementById('blog-sidebar-collapse-control');
		button?.addEventListener('click', () => {
			if (desktopQuery.matches) {
				setCollapsed(!root.hasAttribute('data-blog-sidebar-collapsed'), true);
			}
		});
	})();
</script>
