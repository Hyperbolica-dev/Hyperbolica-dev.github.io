---
import { Icon } from '@astrojs/starlight/components';
import {
	getArticlesByCategory,
	getArticlesByTag,
	getPublicArticles,
	getArticleReadingTime,
	type BlogArticle,
} from '../lib/content';
import { localeFromPath, pathForLocale, ui, type BlogLocale } from '../lib/locale';
import { categories, type BlogCategory } from '../lib/taxonomy';

interface Props {
	category?: BlogCategory;
	tag?: string;
	limit?: number;
	emptyMessage?: string;
	locale?: BlogLocale;
}

const {
	category,
	tag,
	limit,
	emptyMessage,
	locale = localeFromPath(Astro.url.pathname),
} = Astro.props;
const labels = ui[locale];
const emptyText =
	emptyMessage ??
	(category ? labels.categoryEmpty(categories[category][locale].label) : labels.noArticles);

let articles: BlogArticle[];

if (tag) {
	articles = await getArticlesByTag(tag);
} else if (category) {
	articles = await getArticlesByCategory(category);
} else {
	articles = await getPublicArticles();
}

const visibleArticles =
	typeof limit === 'number' ? articles.slice(0, Math.max(0, limit)) : articles;
const dateFormatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en', {
	dateStyle: 'medium',
	timeZone: 'UTC',
});
---

{visibleArticles.length > 0 ? (
	<ul class="article-list">
		{visibleArticles.map((article) => (
			<li class="article-card">
				<article class="article-card-body">
					<div>
						<h3>
							<a href={`/${article.id}/`}>{article.data.title}</a>
						</h3>
						<div class="article-card-meta">
							<time datetime={article.data.publishedAt.toISOString()}>
								{dateFormatter.format(article.data.publishedAt)}
							</time>
							<span>{categories[article.data.category][locale].label}</span>
							<span>
								{getArticleReadingTime(article).minutes} {labels.readTime}
							</span>
							{locale === 'zh' && <span>{labels.originalLanguage}</span>}
						</div>
						<p>{article.data.description}</p>
						{article.data.tags.length > 0 && (
							<ul class="article-tags" aria-label={`Tags for ${article.data.title}`}>
								{article.data.tags.map((articleTag) => (
									<li>
										<a href={pathForLocale(`/tags/${encodeURIComponent(articleTag)}/`, locale)}>
											{articleTag}
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
					<div class="article-card-art" aria-hidden="true"></div>
				</article>
			</li>
		))}
	</ul>
) : (
	<div class="empty-state" role="status">
		<Icon name="document" />
		<p>{emptyText}</p>
	</div>
)}

<style>
	.article-list,
	.article-tags {
		list-style: none;
		padding: 0;
	}

	.article-list {
		display: grid;
		gap: 1rem;
		margin-block: 1rem 0;
	}

	.article-card {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.85rem;
		min-width: 0;
	}

	.article-card-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 7rem;
		gap: 1rem;
		align-items: stretch;
	}

	.article-card h3,
	.article-card p {
		margin-block: 0;
	}

	.article-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.75rem;
		margin-top: 0.35rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.article-card p {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-2);
	}

	.article-card-art {
		min-height: 6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background:
			radial-gradient(circle at 35% 35%, var(--sl-color-accent) 0 1px, transparent 1.5px),
			linear-gradient(135deg, transparent 45%, var(--sl-color-gray-5) 46% 47%, transparent 48%),
			var(--sl-color-bg-nav);
		opacity: 0.8;
	}

	.article-card a,
	.article-tags a {
		overflow-wrap: anywhere;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block: 0.75rem 0;
	}

	.article-tags a {
		display: inline-flex;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		padding: 0.2rem 0.6rem;
		font-size: var(--sl-text-xs);
		text-decoration: none;
	}

	.empty-state {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-2);
		padding: 1rem;
	}

	.empty-state p {
		margin: 0;
	}

	@media (max-width: 39rem) {
		.article-card-body {
			grid-template-columns: minmax(0, 1fr);
		}

		.article-card-art {
			min-height: 3rem;
		}
	}
</style>
