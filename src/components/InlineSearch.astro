---
import { Icon } from '@astrojs/starlight/components';
import { localeFromPath, ui } from '../lib/locale';

const labels = ui[localeFromPath(Astro.url.pathname)];
---

<div
	class="blog-search"
	data-blog-search
	data-no-results={labels.noResults}
	data-search-hint={labels.searchHint}
>
	<label class="blog-search-field">
		<Icon name="magnifier" class="blog-search-icon" />
		<span class="sr-only">{labels.search}</span>
		<input
			type="search"
			autocomplete="off"
			placeholder={labels.search}
			aria-controls="blog-search-results"
			aria-expanded="false"
			data-blog-search-input
		/>
		<kbd aria-hidden="true">Ctrl K</kbd>
	</label>
	<div
		id="blog-search-results"
		class="blog-search-results"
		aria-live="polite"
		data-blog-search-results
		hidden
	>
		<p class="blog-search-status" data-blog-search-status>
			{labels.searchHint}
		</p>
		<ul data-blog-search-list></ul>
	</div>
</div>

<script is:inline>
	(() => {
		const search = document.querySelector('[data-blog-search]');
		const input = search?.querySelector('[data-blog-search-input]');
		const results = search?.querySelector('[data-blog-search-results]');
		const status = search?.querySelector('[data-blog-search-status]');
		const list = search?.querySelector('[data-blog-search-list]');
		if (
			!(input instanceof HTMLInputElement) ||
			!(results instanceof HTMLElement) ||
			!(status instanceof HTMLElement) ||
			!(list instanceof HTMLElement)
		)
			return;
		const noResults = search.dataset.noResults || '';
		const searchHint = search.dataset.searchHint || '';

		let pagefindPromise;
		let timer;
		let requestId = 0;
		const show = () => {
			results.hidden = false;
			input.setAttribute('aria-expanded', 'true');
		};
		const hide = () => {
			results.hidden = true;
			input.setAttribute('aria-expanded', 'false');
		};
		const getPagefind = () => {
			pagefindPromise ||= import(/* @vite-ignore */ '/pagefind/pagefind.js');
			return pagefindPromise;
		};
		const run = async () => {
			const query = input.value.trim();
			const currentRequest = ++requestId;
			list.replaceChildren();
			show();
			if (!query) {
				status.textContent = searchHint;
				return;
			}
			status.textContent = '…';
			try {
				const pagefind = await getPagefind();
				const response = await pagefind.search(query);
				const matches = await Promise.all(
					(response.results || []).slice(0, 8).map((entry) => entry.data()),
				);
				if (currentRequest !== requestId) return;
				status.textContent = matches.length ? '' : noResults;
				for (const match of matches) {
					const item = document.createElement('li');
					const anchor = document.createElement('a');
					anchor.href = match.url;
					const title = document.createElement('strong');
					title.textContent = match.meta?.title || match.title || match.url;
					const excerpt = document.createElement('span');
					const fragment = document.createElement('span');
					fragment.innerHTML = match.excerpt || '';
					excerpt.textContent = fragment.textContent || '';
					anchor.append(title, excerpt);
					item.append(anchor);
					list.append(item);
				}
			} catch {
				if (currentRequest === requestId) status.textContent = noResults;
			}
		};

		input.addEventListener('focus', run);
		input.addEventListener('input', () => {
			clearTimeout(timer);
			timer = setTimeout(run, 140);
		});
		input.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				hide();
				input.blur();
			}
			if (event.key === 'ArrowDown') {
				const first = list.querySelector('a');
				if (first) {
					event.preventDefault();
					first.focus();
				}
			}
		});
		results.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				input.focus();
				hide();
			}
			if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
				const links = [...list.querySelectorAll('a')];
				const index = links.indexOf(document.activeElement);
				const next = event.key === 'ArrowDown' ? links[index + 1] : links[index - 1];
				if (next) {
					event.preventDefault();
					next.focus();
				} else if (event.key === 'ArrowUp' && index === 0) {
					event.preventDefault();
					input.focus();
				}
			}
		});
		document.addEventListener('keydown', (event) => {
			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				input.focus();
				input.select();
				show();
			}
		});
		document.addEventListener('pointerdown', (event) => {
			if (event.target instanceof Node && !search.contains(event.target)) hide();
		});
	})();
</script>

<style>
	.blog-search {
		position: relative;
		width: 100%;
	}
	.blog-search-field {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 2.45rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.6rem;
		padding: 0.35rem 0.65rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		cursor: text;
		transition:
			border-color 140ms ease,
			box-shadow 140ms ease,
			background 140ms ease;
	}
	.blog-search-field:hover {
		border-color: var(--sl-color-gray-3);
	}
	.blog-search-field:focus-within {
		border-color: var(--sl-color-accent);
		box-shadow: 0 0 0 3px var(--sl-color-accent-low);
	}
	.blog-search-icon {
		flex: 0 0 auto;
		color: var(--sl-color-gray-3);
	}
	.blog-search-field:focus-within .blog-search-icon {
		color: var(--sl-color-text-accent);
	}
	.blog-search-field input {
		min-width: 0;
		width: 100%;
		border: 0;
		outline: 0;
		appearance: none;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: var(--sl-text-sm);
	}
	.blog-search-field input::placeholder {
		color: var(--sl-color-gray-3);
		opacity: 1;
	}
	.blog-search-field input::-webkit-search-cancel-button {
		cursor: pointer;
	}
	.blog-search-field kbd {
		flex: 0 0 auto;
		white-space: nowrap;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.25rem;
		padding: 0.08rem 0.3rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-3);
		font: inherit;
		font-size: var(--sl-text-xs);
	}
	.blog-search-results {
		position: absolute;
		z-index: 30;
		inset-block-start: calc(100% + 0.4rem);
		inset-inline: 0;
		max-height: min(25rem, 65vh);
		overflow-y: auto;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.7rem;
		padding: 0.3rem;
		background: var(--sl-color-bg-nav);
		box-shadow: 0 0.8rem 2rem rgb(0 0 0 / 0.16);
	}
	.blog-search-results[hidden] {
		display: none;
	}
	.blog-search-status {
		margin: 0;
		padding: 0.65rem 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.blog-search-status:empty {
		display: none;
	}
	.blog-search-results ul {
		display: grid;
		gap: 0.15rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.blog-search-results :global(li a) {
		display: grid;
		gap: 0.25rem;
		border-radius: 0.45rem;
		padding: 0.65rem 0.75rem;
		color: var(--sl-color-text);
		text-decoration: none;
	}
	.blog-search-results :global(li a:hover),
	.blog-search-results :global(li a:focus-visible) {
		outline: none;
		background: var(--sl-color-accent-low);
	}
	.blog-search-results :global(li strong) {
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		font-weight: 650;
	}
	.blog-search-results :global(li span) {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		line-height: 1.45;
	}
	@media (max-width: 49.99rem) {
		.blog-search-field kbd {
			display: none;
		}
		.blog-search-results {
			max-height: 55vh;
		}
	}
</style>
