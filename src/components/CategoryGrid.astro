---
import { localeFromPath, pathForLocale, ui } from '../lib/locale';
import { categoryIds, categories } from '../lib/taxonomy';

const locale = localeFromPath(Astro.url.pathname);
---

<div id="explore" class="home-category-grid" aria-label={ui[locale].exploreCategories}>
	{categoryIds.map((id) => (
		<a href={pathForLocale(`/${id}/`, locale)}>
			<strong>{categories[id][locale].label}</strong>
			<span>{categories[id][locale].description}</span>
		</a>
	))}
</div>
