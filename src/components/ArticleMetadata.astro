---
import { getArticlePageContext } from '../lib/content';
import { localeFromPath, pathForLocale, ui } from '../lib/locale';
import { categories } from '../lib/taxonomy';

const currentId = Astro.locals.starlightRoute.entry.id;
const context = await getArticlePageContext(currentId);
const locale = localeFromPath(Astro.url.pathname);
const labels = ui[locale];
const dateFormatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en', {
	dateStyle: 'long',
	timeZone: 'UTC',
});
---

{context && (
	<dl class="article-metadata" data-article-ui="metadata">
		<div>
			<dt>{labels.published}</dt>
			<dd>
				<time datetime={context.article.data.publishedAt.toISOString()}>
					{dateFormatter.format(context.article.data.publishedAt)}
				</time>
			</dd>
		</div>
		{context.article.data.updatedAt && (
			<div>
				<dt>{labels.updated}</dt>
				<dd>
					<time datetime={context.article.data.updatedAt.toISOString()}>
						{dateFormatter.format(context.article.data.updatedAt)}
					</time>
				</dd>
			</div>
		)}
		<div>
			<dt>{labels.category}</dt>
			<dd>
				<a href={pathForLocale(`/${context.article.data.category}/`, locale)}>
					{categories[context.article.data.category][locale].label}
				</a>
			</dd>
		</div>
		<div>
			<dt>{labels.readingTime}</dt>
			<dd>
				{context.readingTime.minutes} {labels.readTime}
			</dd>
		</div>
		{context.article.data.tags.length > 0 && (
			<div class="tag-metadata">
				<dt>{labels.tags}</dt>
				<dd>
					<ul>
						{context.article.data.tags.map((tag) => (
							<li>
								<a href={pathForLocale(`/tags/${encodeURIComponent(tag)}/`, locale)}>{tag}</a>
							</li>
						))}
					</ul>
				</dd>
			</div>
		)}
	</dl>
)}

<style>
	.article-metadata {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin-block: 1rem 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}

	.article-metadata > div {
		min-width: 0;
	}

	dt {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	dd {
		margin: 0.15rem 0 0;
	}

	a {
		overflow-wrap: anywhere;
	}

	.tag-metadata {
		flex-basis: 100%;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li a {
		display: inline-flex;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		padding: 0.15rem 0.55rem;
		text-decoration: none;
	}
</style>
