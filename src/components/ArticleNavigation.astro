---
import { getArticlePageContext, type BlogArticle } from '../lib/content';

const currentId = Astro.locals.starlightRoute.entry.id;
const context = await getArticlePageContext(currentId);

function articleHref(article: BlogArticle): string {
	return `/${article.id}/`;
}
---

{
	context && (
		<div class="article-navigation" data-article-ui="navigation">
			{context.series && (
				<section class="series-navigation" aria-labelledby="article-series-title">
					<p class="navigation-label">Series</p>
					<h2 id="article-series-title">{context.series.title}</h2>
					<p class="series-order">Part {context.series.order}</p>
					{(context.series.previous || context.series.next) && (
						<nav class="navigation-grid" aria-label="Series article navigation">
							{context.series.previous && (
								<a href={articleHref(context.series.previous)} data-series-direction="previous">
									<span>Previous in series</span>
									<strong>{context.series.previous.data.title}</strong>
								</a>
							)}
							{context.series.next && (
								<a class="next" href={articleHref(context.series.next)} data-series-direction="next">
									<span>Next in series</span>
									<strong>{context.series.next.data.title}</strong>
								</a>
							)}
						</nav>
					)}
				</section>
			)}

			{(context.chronology.older || context.chronology.newer) && (
				<nav class="navigation-grid chronology" aria-label="Chronological article navigation">
					{context.chronology.older && (
						<a href={articleHref(context.chronology.older)} data-chronology-direction="older">
							<span>Older article</span>
							<strong>{context.chronology.older.data.title}</strong>
						</a>
					)}
					{context.chronology.newer && (
						<a class="next" href={articleHref(context.chronology.newer)} data-chronology-direction="newer">
							<span>Newer article</span>
							<strong>{context.chronology.newer.data.title}</strong>
						</a>
					)}
				</nav>
			)}
		</div>
	)
}

<style>
	.article-navigation {
		display: grid;
		gap: 1.25rem;
		margin-top: 3rem;
	}

	.series-navigation {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1rem;
	}

	.navigation-label,
	.series-order,
	.series-navigation h2 {
		margin: 0;
	}

	.navigation-label {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.series-navigation h2 {
		font-size: var(--sl-text-lg);
	}

	.series-order {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}

	.navigation-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.navigation-grid > a {
		display: grid;
		align-content: start;
		gap: 0.2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.8rem;
		text-decoration: none;
		min-width: 0;
	}

	.navigation-grid > a:only-child.next {
		grid-column: 2;
	}

	.navigation-grid span {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.navigation-grid strong {
		overflow-wrap: anywhere;
	}

	.navigation-grid .next {
		text-align: end;
	}

	.chronology {
		margin-top: 0;
	}

	@media (max-width: 35rem) {
		.navigation-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.navigation-grid > a:only-child.next {
			grid-column: 1;
		}

		.navigation-grid .next {
			text-align: start;
		}
	}
</style>
