---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Quiz from '../../../../../llmq/src/components/llmq/Quiz.astro';
import { CONFIG } from '../../../../../llmq/src/lib/llmq/config';
import { quizStrings } from '../../../../../llmq/src/lib/llmq/strings';
const strings = quizStrings('zh-CN');
---

<StarlightPage
	frontmatter={{
		title: strings.title,
		description: strings.subtitle,
		tableOfContents: false,
		pagefind: CONFIG.PUBLISHED,
		head: CONFIG.PUBLISHED
			? []
			: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex,nofollow' } }],
	}}
>
	<div data-pagefind-ignore>
		<Quiz language="zh-CN" />
	</div>
</StarlightPage>
